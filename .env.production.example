# WhatsGene production settings for docker-compose.yml.
# Copy to ".env" in the repo root ON THE SERVER ONLY:  cp .env.production.example .env
# Then fill in every REQUIRED line. Never commit the filled-in .env.

# --- Domain (REQUIRED) ---
# Hostname pointing at the VPS, e.g. whatsgene.example.com
# No scheme, no trailing slash. Free option: a DuckDNS subdomain.
DOMAIN=whatsgene.example.com
# FRONTEND_BASE_URL=https://whatsgene.example.com
# NUXT_PUBLIC_API_BASE=https://whatsgene.example.com/api
# PUBLIC_BASE_URL=https://whatsgene.example.com/api

# --- Reviewer login (REQUIRED: change this!) ---
# The seeded user is created on first backend start. The value in your
# local backend/.env (dev-only-change-me) must never go live.
AUTH_USERNAME=reviewer
AUTH_PASSWORD=replace-with-a-long-random-password

# --- Search (option 2C: local default + real NCBI per workflow) ---
# "local" = BLAST+ against ./blastdb/swissprot on the server (fast).
# Users can still pick "real NCBI" per workflow on the website; that
# path needs the NCBI lines below. Set SEARCH_BACKEND=ncbi only if you
# want NCBI to be the server default instead.
SEARCH_BACKEND=local
NCBI_EMAIL=you@example.com
NCBI_TOOL=WhatsGene
# NCBI_API_KEY=              # optional, raises the E-utilities rate limit
# NCBI_MAX_WAIT_SECONDS=1800 # NCBI searches abort after 30 min

# --- Model Ask (Muse Spark Open via Modal) ---
# Keep off until the reviewer login works; quotas cap credit exposure.
MODEL_ASK_ENABLED=false
MUSE_BASE_URL=
MUSE_API_KEY=
MUSE_MODEL=muse-spark-open
# ASK_DAILY_LIMIT=20
# JOBS_DAILY_LIMIT=10

# --- WhatsApp (optional; outbound is Meta-gated, see docs/HOSTING.md) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-verify-token
WHATSAPP_TEMPLATE_NAME=whatsgene_job_done
