# Copy to .env or export in your shell / host. Never commit real secrets.
# Search backend: local (default, BLAST+ against $BLASTDB/swissprot) |
# ncbi (opt-in remote) | fixture (recorded JSON for tests/demo)
SEARCH_BACKEND=local
BLASTDB=/data/blastdb
# FIXTURE_CASE=globin_nematode   # only for SEARCH_BACKEND=fixture demo
# LOCAL_BLAST_TIMEOUT_SECONDS=600

# NCBI (only needed for SEARCH_BACKEND=ncbi: tool + contact email etiquette)
NCBI_EMAIL=you@example.com
NCBI_TOOL=WhatsGene
# NCBI_API_KEY=            # optional, raises E-utilities rate limit
# NCBI_POLL_INTERVAL_SECONDS=60   # floor: remote polls never run faster
# NCBI_MAX_WAIT_SECONDS=1800      # remote search aborts past this

# Public URL of this backend (needed for WhatsApp webhook + results links)
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# WhatsApp Cloud API (2 Nov milestone)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_TEMPLATE_NAME=whatsgene_job_done

# Agent layer — Muse Spark Open via Modal Shared Endpoint (PRD §8)
# OpenAI-compatible. Endpoint URL and model name are configurable.
MUSE_BASE_URL=
MUSE_API_KEY=
MUSE_MODEL=muse-spark-open

# Agent-loop budget (PRD §4.1; defaults are open — PRD Open questions #1)
MAX_SEARCHES_PER_JOB=6
MAX_JOB_SECONDS=1800
# Workflows running at once in the worker (NcbiRemote is serialised to 1)
# MAX_CONCURRENT_JOBS=3
# DEVIATION_AUTO_APPLY=false

# Storage
DATABASE_PATH=./whatsgene.db

# Auth: one seeded user, no signup. Set a strong password; the user is
# created on first startup (pre-auth jobs are adopted by it).
AUTH_USERNAME=reviewer
AUTH_PASSWORD=change-me-before-going-live
# COOKIE_SECURE=true   # set on the live HTTPS server

# Model Ask: live Muse answers over stored facts. Off by default; this flag
# is the kill switch (false = deterministic stored-fact answers, zero credit).
# MODEL_ASK_ENABLED=false
# ASK_DAILY_LIMIT=20
# JOBS_DAILY_LIMIT=10
# MODEL_MAX_TOKENS=400
