#!/usr/bin/env bash
# WhatsGene One Box: first run sets everything up, then opens the tool.
# Usage: ./start           this machine only (macOS and Linux; Ctrl+C stops)
#        ./start --share   also reachable from other computers on your network
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
URL="http://127.0.0.1:8000"
HOST="127.0.0.1"
case "${1:-}" in
  "") ;;
  --share) HOST="0.0.0.0" ;;
  *) echo "Usage: ./start [--share]" >&2; exit 2 ;;
esac

step() { printf '\n==> %s\n' "$1"; }

# 1. Python environment -------------------------------------------------
step "Checking the Python environment"
if [ ! -x "$ROOT/backend/.venv/bin/python" ]; then
  echo "Creating backend/.venv ..."
  python3 -m venv "$ROOT/backend/.venv"
fi
"$ROOT/backend/.venv/bin/pip" install -q -r "$ROOT/backend/requirements.txt"

# 2. Login ---------------------------------------------------------------
# The owner picks a username and password on the first page the browser
# shows (decision 017). While the owner is the only account, the
# browser on this machine stays signed in (AUTH_MODE=single, decision
# 016); once the owner adds a person in Settings, every browser logs in.
# An AUTH_MODE line the owner wrote is never touched.
step "Checking the login settings"
touch "$ROOT/backend/.env"
if ! grep -qE '^AUTH_MODE=' "$ROOT/backend/.env"; then
  printf '\nAUTH_MODE=single\n' >> "$ROOT/backend/.env"
  echo "No login page on this machine while you are the only account."
fi

# 3. Built website --------------------------------------------------------
step "Checking the built website"
if [ ! -f "$ROOT/frontend/.output/public/index.html" ]; then
  if ! command -v npm >/dev/null 2>&1; then
    echo "ERROR: the first run needs Node.js (npm) to build the website." >&2
    echo "Install Node.js 20 or newer, then run ./start again." >&2
    exit 1
  fi
  echo "Building the website (first run only, takes a few minutes) ..."
  (cd "$ROOT/frontend" && npm install --no-audit --no-fund && NUXT_PUBLIC_SITE_MODE=app npm run generate)
fi

# 4. Search database (warn only; the app still opens without one) --------
step "Checking the search database"
BLASTDB_DIR="$(grep -E '^BLASTDB=' "$ROOT/backend/.env" | tail -1 | cut -d= -f2- | tr -d ' "')"
if [ -z "$BLASTDB_DIR" ]; then
  echo "NOTE: BLASTDB is not set in backend/.env; using $HOME/blastdb."
  echo "The tool opens either way: open Settings -> Local BLAST"
  echo "setup and press \"Run setup now\" to download and build the database,"
  echo "or use the \"real NCBI\" backend per workflow in the meantime."
  BLASTDB_DIR="$HOME/blastdb"
fi
if ! ls "$BLASTDB_DIR"/swissprot.* >/dev/null 2>&1; then
  echo "NOTE: no database in $BLASTDB_DIR yet. Settings -> Local"
  echo "BLAST setup -> \"Run setup now\" downloads and builds it for you."
else
  echo "Found a local database in $BLASTDB_DIR."
fi

# 5. Serve ----------------------------------------------------------------
step "Starting WhatsGene at $URL (stop with Ctrl+C)"
if [ "$HOST" = "0.0.0.0" ]; then
  LAN_IP="$( (ipconfig getifaddr en0 || ipconfig getifaddr en1 || hostname -I) 2>/dev/null | awk '{print $1; exit}' || true)"
  echo "Sharing on your network. Other computers open: http://${LAN_IP:-<this-computer-address>}:8000"
  echo "They log in with an account you add in Settings -> Accounts."
  echo "Plain http: use this only on a network you trust (see docs/HOSTING.md for HTTPS)."
fi
if command -v open >/dev/null 2>&1; then
  (sleep 2 && open "$URL") &
elif command -v xdg-open >/dev/null 2>&1; then
  (sleep 2 && xdg-open "$URL") &
fi
cd "$ROOT/backend" && exec "$ROOT/backend/.venv/bin/uvicorn" app.main:app \
  --host "$HOST" --port 8000
