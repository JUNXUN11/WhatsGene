# WhatsGene — single-domain HTTPS. Caddy gets a free Let's Encrypt
# certificate automatically once DOMAIN points at this server and
# ports 80/443 are open. {$DOMAIN} is read from the compose .env.
{$DOMAIN} {
	encode gzip

	# Browser calls the API same-origin, so no CORS preflight surprises
	# and the HttpOnly session cookie stays first-party.
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
